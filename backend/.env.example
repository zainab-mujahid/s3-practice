# Backend environment — copy to backend/.env and fill in.
# backend/.env is git-ignored. Never commit real values.
# Do NOT put AWS access keys here: the backend uses the AWS SDK default
# credential provider chain (AWS_PROFILE -> ~/.aws/credentials or SSO).

NODE_ENV=development
BACKEND_PORT=3000

# Exact origin of the Vite dev server (used later for Origin/CSRF checks and S3 CORS)
FRONTEND_URL=http://localhost:5173

# AWS (see docs/aws-setup.md). Region of BOTH buckets, e.g. eu-central-1
AWS_REGION=your-aws-region
# Named profile in ~/.aws/credentials holding the dedicated backend IAM user's
# access key (created with `aws configure --profile <name>`). The key itself
# never goes in this file.
AWS_PROFILE=your-local-profile-name

# Two separate buckets (you create them manually in the AWS Console).
# Lower-case letters, digits and "-" only (no dots: they break HTTPS URLs).
# While these are placeholders the app runs, but makes no S3 calls.
S3_PUBLIC_BUCKET=your-public-images-bucket
S3_PRIVATE_BUCKET=your-private-images-bucket

# Optional but recommended: your 12-digit AWS account ID. Every S3 request then
# carries ExpectedBucketOwner, so S3 refuses to talk to a same-named bucket in
# someone else's account.
# AWS_EXPECTED_BUCKET_OWNER=

# --- Sessions & authentication (local development only) ---
# SESSION_SECRET is generated by `npm run setup:accounts`, which appends it to
# backend/.env. Do not invent one by hand and never commit it.
# SESSION_SECRET=

# true only when the app is served over HTTPS (adds the Secure cookie flag)
COOKIE_SECURE=false
# Session ends after 30 min without requests, and at most 8 h after login
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Optional: where the SQLite DB and password hashes live (default: backend/data)
# DATA_DIR=data
