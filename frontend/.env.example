# Frontend dev-server settings — copy to frontend/.env.local if you need to override.
# Only variables prefixed with VITE_ are exposed to browser code. NEVER put
# secrets, password hashes or AWS credentials in any frontend env file.

# Where the Vite dev proxy forwards /api requests (Node-side only, not bundled).
API_PROXY_TARGET=http://127.0.0.1:3000
